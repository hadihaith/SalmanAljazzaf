---
import { experience } from '../data/cv';
---

<section class="section alt" id="experience">
  <div class="container">
    <span class="eyebrow">Experience</span>
    <h2 class="section-title" data-split>
      From networks to <em>the lecture hall</em>
    </h2>

    <ol class="timeline">
      {
        experience.map((entry, i) => (
          <li class="entry" data-reveal="left" style={`--i: ${i}`}>
            <span class="node" aria-hidden="true" />
            <div class="card" data-tilt="4">
              <header>
                <h3>{entry.org}</h3>
                <span class="unit">{entry.unit}</span>
              </header>
              <ul class="roles">
                {entry.roles.map((role) => (
                  <li>
                    <div class="role-head">
                      <span class="role-title">{role.title}</span>
                      <span class="period">{role.period}</span>
                    </div>
                    {role.points && (
                      <ul class="points">
                        {role.points.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 3rem;
    display: grid;
    gap: 1.5rem;
  }

  /* Track and the line that draws itself as you scroll */
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--border);
  }

  .timeline::after {
    background: linear-gradient(var(--accent), var(--gold));
    transform-origin: top;
    transform: scaleY(var(--draw, 0));
  }

  .entry {
    position: relative;
  }

  .node {
    position: absolute;
    left: calc(-3rem + 4px);
    top: 2rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--surface);
    border: 3px solid var(--accent);
    z-index: 1;
    transform: scale(0);
    transition: transform 0.7s var(--ease-spring) 0.3s;
  }

  .entry:global(.is-visible) .node {
    transform: scale(1);
  }

  .node::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: ripple 2.4s var(--ease) infinite;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--border);
  }

  h3 {
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
  }

  .unit {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .points {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .points li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  .role-title {
    font-weight: 500;
  }

  .period {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .timeline {
      padding-left: 2rem;
    }

    .node {
      left: calc(-2rem + 4px);
    }
  }

  @keyframes ripple {
    0% {
      transform: scale(0.6);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
</style>
