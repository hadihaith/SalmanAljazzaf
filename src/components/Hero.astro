---
import { Image } from 'astro:assets';
import { focusAreas, profile } from '../data/cv';
import portrait from '../assets/profile-cutout.png';

const nameWords = profile.shortName.split(' ');
---

<section class="hero" id="top">
  <div class="backdrop" aria-hidden="true">
    <span class="blob blob-1"></span>
    <span class="blob blob-2"></span>
    <span class="blob blob-3"></span>
    <div class="dots"></div>
    <div class="spotlight"></div>
  </div>

  <div class="container content">
    <div class="text">
      <p class="kicker anim" style="--d: 0">
        <span class="pulse"></span>
        {profile.university} · {profile.college}
      </p>

      <h1>
        <span class="line"><span class="anim-rise prefix" style="--d: 1">Dr.</span></span>
        {
          nameWords.map((word, i) => (
            <span class="line">
              <span class="anim-rise" style={`--d: ${i + 2}`}>
                {word}
              </span>
            </span>
          ))
        }
      </h1>

      <p class="role anim" style="--d: 4">{profile.title}</p>

      <p class="focus anim" style="--d: 5">
        Researching{' '}
        <span class="rotator" data-rotate={JSON.stringify(focusAreas)}>{focusAreas[0]}</span>
      </p>

      <div class="actions anim" style="--d: 6">
        <a class="btn primary" href="#about" data-magnetic>
          Explore CV
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn" href="#contact" data-magnetic>Get in touch</a>
      </div>
    </div>

    <div class="visual anim-pop" style="--d: 3">
      <div class="portrait">
        <div class="ring"></div>
        <div class="ring ring-2"></div>
        <!-- White disc that grows out from behind him, then fades away, on a loop -->
        <span class="disc" aria-hidden="true"></span>
        <span class="echo" aria-hidden="true"></span>
        <span class="echo echo-2" aria-hidden="true"></span>
        <div class="cutout">
          <Image
            src={portrait}
            alt={`Portrait of ${profile.name}`}
            width={800}
            height={800}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="chip chip-1">
        <span class="chip-icon">🎓</span>
        <span><strong>Ph.D.</strong> University of Maryland</span>
      </div>
      <div class="chip chip-2">
        <span class="chip-icon cisco">⌁</span>
        <span><strong>Cisco</strong> CCNA certified</span>
      </div>
      <div class="chip chip-3">
        <span class="chip-icon">◆</span>
        <span><strong>AIS GCC</strong> Chapter Secretary</span>
      </div>
    </div>
  </div>

  <a href="#about" class="scroll-cue anim" style="--d: 8" aria-label="Scroll to about">
    <span>Scroll</span>
    <i></i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    --hx: 0;
    --hy: 0;
  }

  /* ---------- Animated backdrop ---------- */
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
    translate: calc(var(--hx) * var(--m) * 1px) calc(var(--hy) * var(--m) * 1px);
    transition: translate 1.2s var(--ease);
  }

  .blob-1 {
    --m: -80;
    width: 520px;
    height: 520px;
    top: -18%;
    right: -8%;
    background: #c9d6ff;
    animation: morph 16s ease-in-out infinite;
  }

  .blob-2 {
    --m: 60;
    width: 420px;
    height: 420px;
    bottom: -20%;
    left: -10%;
    background: #fde3b0;
    animation: morph 20s ease-in-out infinite reverse;
  }

  .blob-3 {
    --m: -40;
    width: 320px;
    height: 320px;
    top: 35%;
    left: 38%;
    background: #e3d9ff;
    opacity: 0.45;
    animation: morph 24s ease-in-out infinite -8s;
  }

  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(20, 33, 61, 0.14) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, black 30%, transparent 75%);
    animation: drift 30s linear infinite;
  }

  .spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      500px circle at var(--sx, 70%) var(--sy, 40%),
      rgba(37, 70, 201, 0.07),
      transparent 70%
    );
  }

  /* ---------- Layout ---------- */
  .content {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: 3rem;
    padding-block: 7rem 5rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.75rem;
    padding: 0.45rem 1rem 0.45rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22a06b;
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    animation: ping 2s var(--ease) infinite;
  }

  h1 {
    font-size: clamp(3.2rem, 8.5vw, 6.5rem);
    letter-spacing: -0.035em;
    line-height: 0.98;
    margin-bottom: 1.5rem;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .prefix {
    font-size: 0.42em;
    font-style: italic;
    color: var(--gold);
    letter-spacing: 0;
  }

  .role {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text);
    margin: 0 0 0.4rem;
    font-weight: 500;
  }

  .focus {
    font-size: 1.05rem;
    color: var(--muted);
    margin: 0 0 2.25rem;
  }

  .rotator {
    display: inline-block;
    color: var(--accent);
    font-weight: 600;
    background: linear-gradient(transparent 62%, var(--accent-soft) 62%);
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease),
      filter 0.45s var(--ease);
  }

  .rotator:global(.is-out) {
    opacity: 0;
    transform: translateY(-12px);
    filter: blur(6px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.8);
    font-weight: 500;
    font-size: 0.95rem;
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      background 0.3s;
  }

  .btn:hover {
    box-shadow: var(--shadow-lg);
  }

  .btn.primary {
    position: relative;
    overflow: hidden;
    background: var(--text);
    color: #fff;
    border-color: var(--text);
  }

  /* Shine sweep */
  .btn.primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.35), transparent 70%);
    transform: translateX(-120%);
    animation: shine 3.5s var(--ease) 3s infinite;
  }

  .arrow {
    transition: transform 0.4s var(--ease);
  }

  .btn:hover .arrow {
    transform: translateX(4px);
  }

  /* ---------- Portrait ---------- */
  .visual {
    position: relative;
    justify-self: center;
    width: min(400px, 80vw);
    aspect-ratio: 1;
    translate: calc(var(--hx) * 24px) calc(var(--hy) * 24px);
    transition: translate 1s var(--ease);
  }

  .portrait {
    position: absolute;
    inset: 8%;
  }

  /* One loop: the disc grows from the centre, holds, then expands and fades */
  .disc {
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    background: #ffffff;
    /* Blue halo + lift so the white reads clearly against the pale page */
    box-shadow:
      0 0 0 10px rgba(37, 70, 201, 0.1),
      0 0 70px 12px rgba(37, 70, 201, 0.32),
      0 34px 80px rgba(20, 33, 61, 0.22);
    transform: scale(0);
    animation: bloom 5.5s infinite;
  }

  /* Gradient rim that travels with the disc */
  .disc::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 210deg, var(--accent), var(--gold), var(--accent));
    mask: radial-gradient(farthest-side, transparent calc(100% - 5px), black calc(100% - 4px));
  }

  /* Rings that ripple outward as the disc bursts away */
  .echo {
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 3px solid var(--accent);
    opacity: 0;
    animation: echo 5.5s var(--ease) infinite;
  }

  .echo-2 {
    border-color: var(--gold);
    animation-delay: 0.18s;
  }

  /* Taller than the circle and rounded only at the bottom,
     so the shoulders sit inside the circle and the head pops out of the top */
  .cutout {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    aspect-ratio: 1 / 1.18;
    overflow: hidden;
    border-radius: 0 0 50% 50% / 0 0 42.37% 42.37%;
  }

  .cutout img {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    transform-origin: 50% 100%;
    transform: scale(1.12);
    animation: lift 5.5s var(--ease) infinite;
    filter: drop-shadow(0 18px 24px rgba(20, 33, 61, 0.18));
  }

  /* Wait for the preloader before starting the loop */
  :global(body.is-loading) .disc,
  :global(body.is-loading) .echo,
  :global(body.is-loading) .cutout img {
    animation-play-state: paused;
  }

  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), transparent 30%, var(--gold), transparent 70%, var(--accent));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), black calc(100% - 2px));
    animation: spin 10s linear infinite;
  }

  .ring-2 {
    inset: -18px;
    opacity: 0.35;
    background: conic-gradient(from 180deg, var(--gold), transparent 25%, var(--accent), transparent 60%);
    mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), black calc(100% - 1px));
    animation-duration: 18s;
    animation-direction: reverse;
  }

  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-lg);
    font-size: 0.82rem;
    white-space: nowrap;
    color: var(--muted);
    animation:
      chip-in 0.9s var(--ease-spring) both,
      bob 6s ease-in-out infinite;
  }

  .chip strong {
    color: var(--text);
    font-weight: 600;
  }

  .chip-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent-soft);
    font-size: 0.9rem;
  }

  .chip-icon.cisco {
    background: #e6f4fb;
    color: #049fd9;
    font-weight: 700;
  }

  .chip-1 {
    top: 6%;
    left: -12%;
    animation-delay: 1.6s, 0s;
  }

  .chip-2 {
    top: 64%;
    right: -6%;
    animation-delay: 1.8s, -2s;
  }

  .chip-3 {
    bottom: 2%;
    left: -6%;
    animation-delay: 2s, -4s;
  }

  .scroll-cue {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .scroll-cue i {
    width: 1px;
    height: 44px;
    background: linear-gradient(var(--text), transparent);
    transform-origin: top;
    animation: line-drop 2s var(--ease) infinite;
  }

  /* ---------- Entrance (waits for the preloader) ---------- */
  .anim {
    animation: fade-up 1.1s var(--ease) both;
    animation-delay: calc(var(--d) * 110ms + 150ms);
  }

  .anim-rise {
    display: inline-block;
    animation: rise 1.2s var(--ease) both;
    animation-delay: calc(var(--d) * 110ms + 150ms);
  }

  .anim-pop {
    animation: pop 1.4s var(--ease) both;
    animation-delay: calc(var(--d) * 110ms + 150ms);
  }

  :global(body.is-loading) .hero *,
  :global(body.is-loading) .hero *::before,
  :global(body.is-loading) .hero *::after {
    animation-play-state: paused;
  }

  @media (max-width: 900px) {
    .content {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: 6rem;
    }

    .kicker {
      font-size: 0.75rem;
    }

    .actions {
      justify-content: center;
    }

    .visual {
      order: -1;
      width: min(300px, 72vw);
    }

    .chip {
      font-size: 0.72rem;
    }

    .chip-1 {
      left: -10%;
    }

    .chip-2 {
      right: -6%;
    }

    .chip-3 {
      display: none;
    }

    .scroll-cue {
      display: none;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(110%) rotate(3deg);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(6px);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.8) rotate(-6deg);
      filter: blur(10px);
    }
  }

  /* Grow with a springy overshoot, hold, then burst outward and fade */
  @keyframes bloom {
    0% {
      transform: scale(0);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    26% {
      transform: scale(1.08);
      animation-timing-function: ease-in-out;
    }
    34% {
      transform: scale(0.98);
      animation-timing-function: ease-out;
    }
    40% {
      transform: scale(1);
    }
    70% {
      transform: scale(1);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0);
    }
    86% {
      transform: scale(1.32);
      opacity: 0;
    }
    100% {
      transform: scale(1.32);
      opacity: 0;
    }
  }

  @keyframes echo {
    0%,
    70% {
      transform: scale(1);
      opacity: 0;
    }
    72% {
      opacity: 0.9;
    }
    94% {
      transform: scale(1.65);
      opacity: 0;
    }
    100% {
      transform: scale(1.65);
      opacity: 0;
    }
  }

  /* He rises as the disc arrives, and settles back as it bursts away */
  @keyframes lift {
    0%,
    100% {
      transform: scale(1.12) translateY(0);
    }
    30%,
    70% {
      transform: scale(1.12) translateY(-10px);
    }
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      transform: scale(0.6) translateY(20px);
    }
  }

  @keyframes bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -10px;
    }
  }

  @keyframes morph {
    0%,
    100% {
      border-radius: 50%;
      transform: translate(0, 0) scale(1);
    }
    33% {
      border-radius: 40% 60% 55% 45%;
      transform: translate(50px, 30px) scale(1.08);
    }
    66% {
      border-radius: 60% 40% 45% 55%;
      transform: translate(-30px, 40px) scale(0.95);
    }
  }

  @keyframes drift {
    to {
      background-position: 28px 28px;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes ping {
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  @keyframes shine {
    0% {
      transform: translateX(-120%);
    }
    40%,
    100% {
      transform: translateX(120%);
    }
  }

  @keyframes line-drop {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    60% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
</style>
