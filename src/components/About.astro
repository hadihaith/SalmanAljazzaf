---
import { profile, stats } from '../data/cv';
---

<section class="section" id="about">
  <div class="container">
    <span class="eyebrow">About</span>
    <h2 class="section-title" data-split>
      Where engineering meets <em>information systems</em>
    </h2>

    <div class="layout">
      <div class="copy">
        <p class="lead" data-reveal>{profile.summary}</p>
        <p class="bio" data-reveal style="--i: 1">{profile.bio}</p>
      </div>

      <aside class="card facts" data-reveal="right" data-tilt="6" style="--i: 2">
        <h3>At a glance</h3>
        <dl>
          <div>
            <dt>Position</dt>
            <dd>{profile.title}</dd>
          </div>
          <div>
            <dt>Department</dt>
            <dd>{profile.department}</dd>
          </div>
          <div>
            <dt>College</dt>
            <dd>{profile.college}, {profile.university}</dd>
          </div>
          <div>
            <dt>Leadership</dt>
            <dd>Head of Consulting and Training Office · Secretary, AIS GCC Chapter</dd>
          </div>
          <div>
            <dt>Certifications</dt>
            <dd>Cisco CCNA · Microsoft MCTS</dd>
          </div>
        </dl>
        <ul class="links">
          {
            profile.links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    <div class="stats">
      {
        stats.map((stat, i) => (
          <div class="stat" data-reveal="scale" style={`--i: ${i}`}>
            <span class="value" data-count={stat.value} data-suffix={stat.suffix}>
              {stat.value}
              {stat.suffix}
            </span>
            <span class="label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.45;
    margin: 0 0 1.5rem;
  }

  .bio {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0;
  }

  .facts h3 {
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
  }

  dl {
    margin: 0 0 1.25rem;
    display: grid;
    gap: 1rem;
  }

  dt {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin: 0.15rem 0 0;
    font-weight: 500;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .links a {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    font-weight: 500;
    transition:
      color 0.3s,
      padding 0.4s var(--ease);
  }

  .links a:hover {
    color: var(--accent);
    padding-inline: 0.5rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid var(--border);
  }

  .stat {
    display: grid;
    gap: 0.35rem;
    padding: 2rem 1.5rem 0;
    border-left: 1px solid var(--border);
  }

  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .value {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    line-height: 1;
    background: linear-gradient(135deg, var(--text), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .label {
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
