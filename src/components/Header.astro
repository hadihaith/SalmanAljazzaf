---
import { nav, profile } from '../data/cv';
---

<div class="scroll-progress" aria-hidden="true"></div>
<header class="site-header">
  <div class="container inner">
    <a href="#top" class="brand">
      <span class="mono">SA</span>
      <span class="name">{profile.shortName}</span>
    </a>
    <nav class="nav" aria-label="Sections">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .scroll-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
    background: linear-gradient(90deg, var(--accent), var(--gold));
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-block: 1.25rem;
    border-bottom: 1px solid transparent;
    transition:
      padding 0.5s var(--ease),
      background 0.5s var(--ease),
      border-color 0.5s var(--ease),
      transform 1s var(--ease) 0.5s,
      opacity 1s var(--ease) 0.5s;
  }

  :global(body.is-loading) .site-header {
    opacity: 0;
    transform: translateY(-100%);
  }

  .site-header:global(.is-scrolled) {
    padding-block: 0.7rem;
    background: rgba(251, 250, 247, 0.8);
    backdrop-filter: blur(14px) saturate(1.4);
    border-color: var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .mono {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--text);
    color: #fff;
    font-size: 0.9rem;
    transition: transform 0.6s var(--ease-spring);
  }

  .brand:hover .mono {
    transform: rotate(360deg) scale(1.08);
  }

  .nav {
    display: flex;
    gap: 0.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
  }

  .nav a {
    position: relative;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    transition:
      color 0.3s,
      background 0.3s;
  }

  .nav a:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  .nav a:global(.is-active) {
    color: #fff;
    background: var(--text);
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }
  }
</style>
