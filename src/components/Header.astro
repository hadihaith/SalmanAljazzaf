---
import { nav, profile } from '../data/cv';
---

<div class="scroll-progress" aria-hidden="true"></div>
<header class="site-header">
  <div class="container inner">
    <a href="#top" class="brand">{profile.name}</a>
    <nav class="nav" aria-label="Sections">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .scroll-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-block: 1.25rem;
    transition:
      padding 0.4s var(--ease),
      background 0.4s var(--ease),
      border-color 0.4s var(--ease);
    border-bottom: 1px solid transparent;
    animation: drop-in 0.9s var(--ease) both;
  }

  .site-header:global(.is-scrolled) {
    padding-block: 0.75rem;
    background: rgba(11, 18, 32, 0.75);
    backdrop-filter: blur(12px);
    border-color: var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .nav a {
    position: relative;
    transition: color 0.3s;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.4s var(--ease);
  }

  .nav a:hover,
  .nav a:global(.is-active) {
    color: var(--text);
  }

  .nav a:hover::after,
  .nav a:global(.is-active)::after {
    transform: scaleX(1);
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }
  }

  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(-100%);
    }
  }
</style>
