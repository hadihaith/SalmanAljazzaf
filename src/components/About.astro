---
import { profile, stats } from '../data/cv';
---

<section class="section" id="about">
  <div class="container">
    <span class="eyebrow" data-reveal>About</span>
    <h2 class="section-title" data-reveal style="--i: 1">A brief introduction</h2>

    <div class="layout">
      <p class="summary" data-reveal style="--i: 2">{profile.summary}</p>
      <ul class="links" data-reveal="left" style="--i: 3">
        {
          profile.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="stats">
      {
        stats.map((stat, i) => (
          <div class="card stat" data-reveal="scale" style={`--i: ${i}`}>
            <span class="value" data-count={stat.value} data-suffix={stat.suffix}>
              {stat.value}
              {stat.suffix}
            </span>
            <span class="label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .summary {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--muted);
    margin: 0;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .links a {
    display: flex;
    justify-content: space-between;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border);
    transition:
      color 0.3s,
      padding 0.3s var(--ease);
  }

  .links a:hover {
    color: var(--accent);
    padding-left: 0.5rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 4rem;
  }

  .stat {
    display: grid;
    gap: 0.25rem;
    text-align: center;
  }

  .value {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--accent);
  }

  .label {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
