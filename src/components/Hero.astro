---
import { profile } from '../data/cv';

const words = profile.name.split(' ');
const initials = words
  .filter((w) => !w.endsWith('.'))
  .map((w) => w[0])
  .join('');
---

<section class="hero" id="top">
  <div class="orbs" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>
  <div class="grid-bg" aria-hidden="true"></div>

  <div class="container content">
    <div class="text">
      <span class="eyebrow fade" style="--d: 0">{profile.university}</span>
      <h1>
        {
          words.map((word, i) => (
            <span class="word">
              <span style={`--d: ${i + 1}`}>{word}</span>
            </span>
          ))
        }
      </h1>
      <p class="role fade" style={`--d: ${words.length + 1}`}>
        {profile.title} · {profile.department}
      </p>
      <div class="actions fade" style={`--d: ${words.length + 2}`}>
        <a class="btn primary" href="#about">View CV</a>
        <a class="btn" href="#contact">Get in touch</a>
      </div>
    </div>

    <div class="portrait fade" style={`--d: ${words.length}`}>
      <div class="ring"></div>
      {
        profile.photo ? (
          <img src={profile.photo} alt={profile.name} />
        ) : (
          <span class="initials">{initials}</span>
        )
      }
    </div>
  </div>

  <a href="#about" class="scroll-cue" aria-label="Scroll to about">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .orbs {
    position: absolute;
    inset: 0;
    z-index: -2;
    filter: blur(70px);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    opacity: 0.45;
    animation: float 18s ease-in-out infinite;
  }

  .orb-1 {
    width: 480px;
    height: 480px;
    background: #3b5bdb;
    top: -10%;
    left: -10%;
  }

  .orb-2 {
    width: 380px;
    height: 380px;
    background: #b8860b;
    bottom: -10%;
    right: -5%;
    animation-delay: -6s;
    animation-duration: 22s;
  }

  .orb-3 {
    width: 300px;
    height: 300px;
    background: #6741d9;
    top: 40%;
    left: 45%;
    animation-delay: -12s;
    opacity: 0.3;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);
    animation: pan 40s linear infinite;
  }

  .content {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: 3rem;
    padding-top: 5rem;
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    margin-right: 0.25em;
    padding-bottom: 0.08em;
  }

  .word > span {
    display: inline-block;
    animation: rise 1s var(--ease) both;
    animation-delay: calc(var(--d) * 120ms + 200ms);
  }

  .fade {
    animation: fade-up 1s var(--ease) both;
    animation-delay: calc(var(--d) * 120ms + 200ms);
  }

  .role {
    color: var(--muted);
    font-size: 1.15rem;
    margin: 0 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-weight: 500;
    font-size: 0.95rem;
    transition:
      transform 0.3s var(--ease),
      background 0.3s,
      border-color 0.3s;
  }

  .btn:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .btn.primary {
    background: var(--accent);
    color: #1a1406;
    border-color: var(--accent);
  }

  .btn.primary:hover {
    background: #f2d39a;
  }

  .portrait {
    position: relative;
    justify-self: center;
    width: min(320px, 70vw);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--bg-soft), #1b2742);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .initials {
    font-family: var(--font-serif);
    font-size: 5rem;
    color: var(--accent);
  }

  .ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), transparent 40%, var(--accent-2), transparent 80%, var(--accent));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), black calc(100% - 1px));
    animation: spin 12s linear infinite;
  }

  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border: 1.5px solid var(--muted);
    border-radius: 999px;
    animation: fade-up 1s var(--ease) 1.4s both;
  }

  .scroll-cue span {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--accent);
    animation: scroll-dot 1.8s var(--ease) infinite;
  }

  @media (max-width: 820px) {
    .content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .portrait {
      order: -1;
      width: min(200px, 55vw);
    }

    .initials {
      font-size: 3.5rem;
    }

    .actions {
      justify-content: center;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(110%);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(60px, 40px) scale(1.1);
    }
    66% {
      transform: translate(-40px, 30px) scale(0.95);
    }
  }

  @keyframes pan {
    to {
      background-position: 60px 60px;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes scroll-dot {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
