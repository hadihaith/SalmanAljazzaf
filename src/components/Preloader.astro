<div class="preloader" aria-hidden="true">
  <svg class="mark" viewBox="0 0 120 120">
    <circle class="ring" cx="60" cy="60" r="54"></circle>
    <text x="60" y="62" text-anchor="middle" dominant-baseline="middle">SA</text>
  </svg>
  <div class="panel panel-1"></div>
  <div class="panel panel-2"></div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .panel {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: transform 1s var(--ease);
  }

  .panel-1 {
    background: var(--text);
  }

  .panel-2 {
    background: var(--accent);
    z-index: -2;
    transition-delay: 0.15s;
  }

  .mark {
    width: 120px;
    transition:
      opacity 0.5s var(--ease),
      transform 0.8s var(--ease);
  }

  .ring {
    fill: none;
    stroke: var(--gold);
    stroke-width: 2;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
    transform-origin: center;
    transform: rotate(-90deg);
    animation: draw 1.1s var(--ease) forwards;
  }

  text {
    font-family: var(--font-serif);
    font-size: 40px;
    fill: #fff;
    opacity: 0;
    animation: appear 0.8s var(--ease) 0.3s forwards;
  }

  :global(body:not(.is-loading)) .mark {
    opacity: 0;
    transform: scale(0.85);
  }

  :global(body:not(.is-loading)) .panel-1 {
    transform: translateY(-100%);
  }

  :global(body:not(.is-loading)) .panel-2 {
    transform: translateY(-100%);
  }

  :global(.no-js) .preloader {
    display: none;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
