---
import { profile } from '../data/cv';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<section class="contact" id="contact">
  <div class="glow" aria-hidden="true"></div>
  <div class="container inner">
    <span class="eyebrow">Contact</span>
    <h2 data-split>Let's <em>connect.</em></h2>
    <p data-reveal style="--i: 1">
      {profile.college}, {profile.university} · Office {profile.office}
    </p>
    <a class="email" href={`mailto:${profile.email}`} data-reveal style="--i: 2" data-magnetic>
      {profile.email}
    </a>
    <p class="mail-hint" role="status" hidden>
      Your mail app didn't open? Copy the address and write from any email account.
      <button type="button" class="copy" data-copy={profile.email}>Copy email</button>
    </p>
    <div class="socials" data-reveal style="--i: 3">
      <SocialLinks labeled />
    </div>
    <ul class="links" data-reveal style="--i: 4">
      {
        profile.links
          .filter((link) => !link.social && !link.href.startsWith('mailto:'))
          .map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener">
                {link.label} ↗
              </a>
            </li>
          ))
      }
    </ul>
  </div>

  <footer class="footer container">
    <span>© {year} {profile.name}</span>
    <a href="#top">Back to top ↑</a>
  </footer>
</section>

<script>
  // mailto links give no error when no mail app is set up. Opening one normally takes
  // focus away from the page, so if the page still has focus shortly after the click,
  // assume nothing opened and bring the visitor to the address here instead.
  const email = document.querySelector<HTMLElement>('.contact .email');
  const hint = document.querySelector<HTMLElement>('.mail-hint');
  const copy = document.querySelector<HTMLButtonElement>('.mail-hint .copy');

  document.querySelectorAll<HTMLAnchorElement>('[data-mail-fallback]').forEach((link) => {
    link.addEventListener('click', () => {
      let left = false;
      const markLeft = () => (left = true);
      window.addEventListener('blur', markLeft, { once: true });
      document.addEventListener('visibilitychange', markLeft, { once: true });
      window.addEventListener('pagehide', markLeft, { once: true });

      setTimeout(() => {
        window.removeEventListener('blur', markLeft);
        document.removeEventListener('visibilitychange', markLeft);
        window.removeEventListener('pagehide', markLeft);
        if (left || document.hidden || !document.hasFocus()) return;

        document.getElementById('contact')?.scrollIntoView();
        if (hint) hint.hidden = false;
        email?.classList.remove('is-flagged');
        void email?.offsetWidth; // restart the highlight if it runs twice
        email?.classList.add('is-flagged');
      }, 2000);
    });
  });

  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copy ?? '');
      copy.textContent = 'Copied ✓';
    } catch {
      // Clipboard blocked: select the address so it can be copied by hand
      if (email) getSelection()?.selectAllChildren(email);
      copy.textContent = 'Press Ctrl+C to copy';
    }
  });
</script>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--text);
    color: #fff;
    text-align: center;
    padding-top: clamp(5rem, 12vw, 9rem);
  }

  .glow {
    position: absolute;
    left: 50%;
    top: 30%;
    width: 900px;
    height: 900px;
    translate: -50% -50%;
    z-index: -1;
    background: conic-gradient(from 0deg, rgba(37, 70, 201, 0.5), rgba(192, 138, 30, 0.35), rgba(37, 70, 201, 0.5));
    filter: blur(120px);
    opacity: 0.6;
    border-radius: 50%;
    animation: spin 20s linear infinite;
  }

  .eyebrow {
    color: var(--gold);
  }

  h2 {
    font-size: clamp(3rem, 10vw, 7.5rem);
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  h2 :global(em) {
    color: var(--gold);
  }

  p {
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 2.5rem;
  }

  .email {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 3.5vw, 2.2rem);
    padding: 1rem 2rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    word-break: break-all;
    transition:
      transform 0.4s var(--ease),
      background 0.4s,
      color 0.4s;
  }

  .email:hover {
    background: #fff;
    color: var(--text);
  }

  /* Pulses gold when the visitor lands here because their mail app didn't open */
  .email:global(.is-flagged) {
    animation: flag 1.4s var(--ease) 0.6s 3;
  }

  .mail-hint {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }

  .mail-hint[hidden] {
    display: none;
  }

  .copy {
    margin-left: 0.5rem;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .copy:hover {
    background: var(--gold);
    color: var(--text);
  }

  @keyframes flag {
    0% {
      box-shadow: 0 0 0 0 rgba(192, 138, 30, 0.7);
      border-color: var(--gold);
    }
    100% {
      box-shadow: 0 0 0 22px rgba(192, 138, 30, 0);
    }
  }

  .socials {
    margin-top: 2.25rem;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .links a {
    color: rgba(255, 255, 255, 0.75);
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 0.15rem;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .links a:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(4rem, 10vw, 7rem);
    padding-block: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.85rem;
  }

  .footer a:hover {
    color: #fff;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }
</style>
